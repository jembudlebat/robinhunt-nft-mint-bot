# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Admin User ID (Numeric ID from @userinfobot)
TELEGRAM_ADMIN_ID=123456789

# Master 32-character AES-256 Key for private key encryption (Must be 32 characters or 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default Robinhood Chain Primary & Fallback RPC URLs (comma separated)
DEFAULT_RPC_URLS=https://rpc.robinhoodchain.com,https://rpc-fallback.robinhoodchain.com

# Chain ID for Robinhood Chain L2 (Default EVM / Arbitrum Orbit stack ID)
DEFAULT_CHAIN_ID=123456

# Database File Path
DB_PATH=./data/robinhunt.db

# Log Level (info, debug, warn, error)
LOG_LEVEL=info
