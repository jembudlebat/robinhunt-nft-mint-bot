{
  "name": "robinhunt-nft-mint-bot",
  "version": "1.0.0",
  "description": "Production-ready Telegram Bot for Robinhood Chain NFT Minting with multi-wallet, multi-RPC failover, and live contract monitoring.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "telegram-bot",
    "nft-minting",
    "robinhood-chain",
    "ethereum",
    "ethers",
    "telegraf",
    "bot"
  ],
  "author": "Senior Blockchain Engineer",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
